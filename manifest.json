{
  "manifest_version": 3,
  "name": "Lumina",
  "version": "1.0",
  "description": "A premium Chrome extension for capturing pixel-perfect, full-page screenshots natively.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Take Full-Page Screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
